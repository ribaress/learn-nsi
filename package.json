{
  "name": "atelier-nsi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173 --strictPort",
    "build": "node scripts/copy-pyodide.mjs && node scripts/generate-course-index.mjs && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4174 --strictPort",
    "postinstall": "node scripts/copy-pyodide.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:solutions": "node scripts/check-course-solutions.mjs",
    "content:index": "node scripts/generate-course-index.mjs",
    "format": "prettier --write src tests scripts *.js *.json *.md",
    "format:check": "prettier --check src tests scripts *.js *.json *.md"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "@phosphor-icons/vue": "^2.2.1",
    "@fontsource/plus-jakarta-sans": "^5.2.0",
    "pyodide": "0.29.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.9.10",
    "vite": "^7.2.0",
    "vitest": "^3.2.0"
  }
}
